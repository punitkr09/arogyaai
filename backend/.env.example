# Arogya AI — Backend Environment Configuration
# Copy this file to backend/.env or configure in hosting dashboard (Render / Railway / Fly.io)

APP_NAME="Arogya AI — Pharmaceutical Operations & Autonomous Intelligence"
APP_VERSION=1.0.0
APP_ENV=production
HOST=0.0.0.0
PORT=8000

# Database Persistence
# SQLite (Local):
DATABASE_URL=sqlite:///./arogya.db
# PostgreSQL (Production):
# DATABASE_URL=postgresql://user:password@host:5432/arogya_db

# Business Date Snapshot
BUSINESS_REFERENCE_DATE=2026-11-16

# CORS Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://arogyaai.vercel.app
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# AI Provider ('ollama', 'openai', or 'semantic')
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen2.5-coder:7b
AI_API_KEY=
AI_TIMEOUT_SECONDS=45
OLLAMA_BASE_URL=http://localhost:11434

DEFAULT_EXECUTION_MODE=operations
