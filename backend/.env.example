# Environment Configuration
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Database Configuration (SQLite default with absolute path fallback)
DATABASE_URL=sqlite:///./arogya.db

# Configurable Business Reference Date (Default dataset business date is 2026-11-16)
BUSINESS_REFERENCE_DATE=2026-11-16

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# AI Provider Configuration: 'ollama', 'openai', or 'semantic'
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen2.5-coder:7b
AI_API_KEY=
AI_TIMEOUT_SECONDS=15

# Legacy / Alternative LLM endpoints
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Default execution mode: 'operations' or 'demo'
DEFAULT_EXECUTION_MODE=operations

