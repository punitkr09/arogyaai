# Environment Configuration
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Database Configuration (SQLite default for demo)
DATABASE_URL=sqlite:///./arogya.db

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# LLM Provider Configuration: 'mock', 'openai', 'gemini', 'ollama'
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Default execution mode: 'demo' or 'live'
DEFAULT_EXECUTION_MODE=demo
