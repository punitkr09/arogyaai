# Arogya AI — Production & Local Environment Configuration
# Copy this file to .env for local development or configure in your deployment dashboard (e.g. Render, Railway, Fly.io)

# -----------------------------------------------------------------------------
# Core Application Settings
# -----------------------------------------------------------------------------
APP_NAME="Arogya AI — Pharmaceutical Operations & Autonomous Intelligence"
APP_VERSION=1.0.0
APP_ENV=production
HOST=0.0.0.0
# Port will be automatically set by cloud providers (e.g., Render sets $PORT)
PORT=8000

# -----------------------------------------------------------------------------
# Database Persistence
# -----------------------------------------------------------------------------
# Local SQLite default:
# DATABASE_URL=sqlite:///./arogya.db

# Production Persistent SQLite on Render Disk (mount /var/data):
# DATABASE_URL=sqlite:////var/data/arogya.db

# Production Managed PostgreSQL (Render PostgreSQL, Supabase, Neon, Railway):
# DATABASE_URL=postgresql://user:password@host:5432/arogya_db
DATABASE_URL=sqlite:///./arogya.db

# Configurable Business Reference Date (Datasets reference date is 2026-11-16)
BUSINESS_REFERENCE_DATE=2026-11-16

# -----------------------------------------------------------------------------
# CORS Allowed Origins
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins. Add your Vercel production frontend URL here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://arogyaai.vercel.app

# Regular expression allowing any Vercel deployment preview or production domain:
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# -----------------------------------------------------------------------------
# AI Inference & Agent Configuration
# -----------------------------------------------------------------------------
# Options: 'ollama' (local inference), 'openai' (remote OpenAI-compatible), 'semantic' (deterministic fallback)
AI_PROVIDER=ollama

# If using local Ollama (development / self-hosted GPU):
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen2.5-coder:7b
AI_API_KEY=
AI_TIMEOUT_SECONDS=45

# If using cloud OpenAI-compatible provider in production (e.g. Groq, Together, OpenAI):
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=sk-your-openai-api-key

# Legacy aliases:
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Default execution mode: 'operations' or 'demo'
DEFAULT_EXECUTION_MODE=operations
