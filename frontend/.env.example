# Arogya AI — Frontend Environment Configuration
# Copy this file to .env or configure in your deployment dashboard (e.g. Vercel)

# In local development: leave empty to use Vite's local dev proxy to http://127.0.0.1:8000
# In production on Vercel: set to your deployed backend base URL (without trailing /api)
# Example: VITE_API_URL=https://arogyaai-backend.onrender.com
VITE_API_URL=
